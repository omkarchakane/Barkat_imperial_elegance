SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Use either DATABASE_URL or the DB_* values below.
DATABASE_URL=
DB_NAME=barkat_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Render sets this automatically for public services.
RENDER_EXTERNAL_HOSTNAME=

# Optional production overrides
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Media note:
# On Render, local media files are not permanent unless you attach persistent
# storage or move uploads to a service like Cloudinary or S3.
MEDIA_URL=/media/
MEDIA_ROOT=media
